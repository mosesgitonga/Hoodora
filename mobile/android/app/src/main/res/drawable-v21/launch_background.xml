<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: the mark, centred, on the app's
     background. Android 12+ shows the launcher icon instead (values-v31). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:drawable="@drawable/launch_mark"
        android:gravity="center" />
</layer-list>
